<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>devops-agents-hook</AssemblyName>
    <RootNamespace>DevOpsAgents.Hooks</RootNamespace>
    <!-- un hook parte a ogni chiamata di strumento: avvio rapido -->
    <TieredPGO>true</TieredPGO>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DevOpsAgents.Core\DevOpsAgents.Core.csproj" />
  </ItemGroup>
</Project>
